{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "addressable.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Addressable (memory region, register group, etc) schema for RISC-V",
    "title": "addressable",
    "type": "object",
    "properties": {
        "description": {
            "$ref": "description.schema.json"
        },
        "offset": {
            "type": "string"
        },
        "size": {
            "type": "string"
        },
        "read": {
            "type": "boolean"
        },
        "write": {
            "type": "boolean"
        },
        "execute": {
            "type": "boolean"
        },
        "imports": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "$ref": "import.schema.json"
                }
            }
        },
        "registers": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "anyOf": [
                        {
                            "$ref": "register.schema.json"
                        },
                        {
                            "$ref": "reference.schema.json"
                        }
                    ]
                }
            }
        },
        "overlappings": {
            "$ref": "overlapping.schema.json"
        },
        "attributes": {
            "type": "object",
            "properties": {
                "atomicity": {
                    "type": "object",
                    "properties": {
                        "amo_support": {
                            "type": "string",
                            "enum": [
                                "none",
                                "swap",
                                "logical",
                                "arithmetic"
                            ]
                        },
                        "reservability": {
                            "type": "string",
                            "enum": [
                                "none",
                                "non_eventual",
                                "eventual"
                            ]
                        }
                    }
                }
            }
        },
        "vendor": {
            "$ref": "vendor.schema.json"
        },
        "indexing": {
            "$ref": "indexing.schema.json"
        },
        "default": {
            "properties": {
                "register": {
                    "properties": {
                        "class": {
                            "type": "string",
                            "enum": [
                                "control_status",
                                "memory_mapped"
                            ]
                        },
                        "width": {
                            "type": "integer",
                            "multipleOf": 8
                        },
                        "hw_volatile": {
                            "type": "boolean"
                        },
                        "access_policy": {
                            "type": "string",
                            "enum": [
                                "read_only",
                                "write_only",
                                "read_write",
                                "write_once",
                                "read_write_once"
                            ]
                        }
                    },
                    "required": [
                        "class"
                    ]
                }
            },
            "required": [
                "register"
            ]
        }
    },
    "required": [
        "size",
        "default"
    ]
}
