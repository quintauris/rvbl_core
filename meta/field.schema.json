{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "field.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Field schema for RISC-V",
    "title": "Field",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "$ref": "description.schema.json"
        },
        "position": {
            "type": "integer"
        },
        "length": {
            "type": "integer"
        },
        "values": {
            "type": "array",
            "items": {
                "$ref": "value.schema.json"
            }
        },
        "ranges": {
            "type": "array",
            "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                    "type": "string"
                }
            }
        },
        "on_read": {
            "type": "array",
            "items": {
                "enum": [
                    "clear",
                    "set",
                    "toggle",
                    "modify",
                    "modify_external"
                ]
            },
            "required": [
                "action"
            ]
        },
        "on_write": {
            "type": "object",
            "patternProperties": {
                "^[01]+$": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "clear",
                            "set",
                            "toggle",
                            "modify",
                            "modify_external"
                        ]
                    }
                }
            },
            "additionalProperties": false
        },
        "on_reset": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string",
                        "pattern": "^[01]+$"
                    },
                    "mask": {
                        "type": "string",
                        "pattern": "^[01]+$"
                    }
                },
                "required": [
                    "name",
                    "value"
                ]
            }
        },
        "read_policy": {
            "type": "string",
            "enum": [
                "ignore",
                "legal",
                "any"
            ]
        },
        "write_policy": {
            "type": "string",
            "enum": [
                "preserve",
                "legal",
                "any"
            ]
        },
        "volatile": {
            "type": "boolean"
        },
        "vendor": {
            "$ref": "vendor.schema.json"
        },
        "indexing": {
            "$ref": "indexing.schema.json"
        }
    },
    "required": [
        "name",
        "position"
    ]
}
