{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "machine.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Machine schema for RISC-V",
    "title": "Machine",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "$ref": "description.schema.json"
        },
        "word_size": {
            "type": "integer",
            "multipleOf": 8
        },
        "max_transfer_size": {
            "type": "integer",
            "multipleOf": 8
        },
        "imports": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "$ref": "import.schema.json"
                }
            }
        },
        "memory_map": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "anyOf": [
                        {
                            "$ref": "addressable.schema.json"
                        },
                        {
                            "$ref": "reference.schema.json"
                        }
                    ]
                }
            }
        },
        "peripherals": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "anyOf": [
                        {
                            "$ref": "peripheral.schema.json"
                        },
                        {
                            "$ref": "reference.schema.json"
                        }
                    ]
                }
            }
        },
        "overlappings": {
            "type": "object",
            "properties": {
                "addressables": {
                    "$ref": "overlapping.schema.json"
                },
                "peripherals": {
                    "$ref": "overlapping.schema.json"
                }
            }
        },
        "reset_types": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "$ref": "reset_type.schema.json"
                }
            }
        },
        "parameters": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "$ref": "parameter.schema.json"
                }
            }
        },
        "vendor": {
            "$ref": "vendor.schema.json"
        }
    },
    "required": [
        "name",
        "word_size",
        "memory_map",
        "peripherals",
        "parameters"
    ]
}
