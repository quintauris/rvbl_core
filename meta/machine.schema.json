{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "machine.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Machine schema for RISC-V",
    "title": "Machine",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "word_size": {
            "type": "integer",
            "multipleOf": 8
        },
        "memory_map": {
            "type": "array",
            "items": {
                "$ref": "addressable.schema.json"
            }
        },
        "peripherals": {
            "type": "array",
            "items": {
                "$ref": "peripheral.schema.json"
            }
        },
        "parameters": {
            "type": "array",
            "items": {
                "$ref": "parameter.schema.json"
            }
        }
    },
    "required": [
        "name",
        "word_size",
        "memory_map",
        "peripherals",
        "parameters"
    ]
}
