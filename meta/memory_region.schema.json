{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "memory_region.schema.json",
    "description": "Memory Region schema for RISC-V",
    "title": "Memory Region",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "base": {
            "type": "string"
        },
        "size": {
            "type": "string"
        },
        "read": {
            "type": "boolean"
        },
        "write": {
            "type": "boolean"
        },
        "execute": {
            "type": "boolean"
        },
        "registers": {
            "type": "array",
            "items": {
                "$ref": "register.schema.json"
            }
        }
    },
    "required": [
        "name",
        "base",
        "size"
    ]
}
