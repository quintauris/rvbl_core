{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "peripheral.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Peripheral schema for RISC-V",
    "title": "Peripheral",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "instance": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "word_size": {
            "type": "integer",
            "multipleof": 8
        },
        "addressables": {
            "type": "array",
            "items": {
                "$ref": "addressable.schema.json"
            },
            "minItems": 1
        },
        "parameters": {
            "type": "array",
            "items": {
                "$ref": "parameter.schema.json"
            }
        }
    },
    "required": [
        "name",
        "instance",
        "addressables"
    ]
}
