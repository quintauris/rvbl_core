{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "peripheral.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Peripheral schema for RISC-V",
    "title": "Peripheral",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "instance": {
            "type": "string"
        },
        "base": {
            "type": "string"
        },
        "description": {
            "$ref": "description.schema.json"
        },
        "word_size": {
            "type": "integer",
            "multipleof": 8
        },
        "imports": {
            "type": "array",
            "items": {
                "$ref": "import.schema.json"
            }
        },
        "addressables": {
            "type": "array",
            "items": {
                "anyOf": [
                    {
                        "$ref": "addressable.schema.json"
                    },
                    {
                        "$ref": "reference.schema.json"
                    }
                ]
            },
            "minItems": 1
        },
        "overlappings": {
            "$ref": "overlapping.schema.json"
        },
        "parameters": {
            "type": "array",
            "items": {
                "$ref": "parameter.schema.json"
            }
        },
        "vendor": {
            "$ref": "vendor.schema.json"
        },
        "indexing": {
            "$ref": "indexing.schema.json"
        }
    },
    "required": [
        "name",
        "addressables"
    ]
}
