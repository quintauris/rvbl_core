{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "reference.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "(Symbolic) Reference schema for RISC-V",
    "title": "Reference",
    "type": "object",
    "properties": {
        "reference": {
            "type": "string"
        },
        "description": {
            "$ref": "description.schema.json"
        },
        "substitutions": {
            "type": "object"
        },
        "peripheral": {
            "type": "object",
            "properties": {
                "instance": {
                    "type": "string"
                },
                "base": {
                    "type": "string"
                }
            },
            "required": [
                "instance"
            ]
        },
        "vendor": {
            "$ref": "vendor.schema.json"
        }
    },
    "required": [
        "reference"
    ]
}
