{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "register.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Register schema for RISC-V",
    "title": "Register",
    "type": "object",
    "properties": {
        "description": {
            "$ref": "description.schema.json"
        },
        "class": {
            "enum": [
                "control_status",
                "memory_mapped"
            ]
        },
        "width": {
            "type": "integer"
        },
        "offset": {
            "type": "string"
        },
        "hw_volatile": {
            "type": "boolean"
        },
        "endianness": {
            "type": "string",
            "enum": [
                "little",
                "big"
            ]
        },
        "imports": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "$ref": "import.schema.json"
                }
            }
        },
        "values": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "$ref": "value.schema.json"
                }
            }
        },
        "fields": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "anyOf": [
                        {
                            "$ref": "field.schema.json"
                        },
                        {
                            "$ref": "reference.schema.json"
                        }
                    ]
                }
            }
        },
        "overlappings": {
            "$ref": "overlapping.schema.json"
        },
        "access_policy": {
            "type": "string",
            "enum": [
                "read_only",
                "write_only",
                "read_write",
                "write_once",
                "read_write_once"
            ]
        },
        "on_reset": {
            "type": "object",
            "patternProperties": {
                ".+": {
                    "value": {
                        "type": "string",
                        "pattern": "^[01]+$"
                    },
                    "mask": {
                        "type": "string",
                        "pattern": "^[01]+$"
                    },
                    "required": [
                        "value"
                    ]
                }
            }
        },
        "indexing": {
            "$ref": "indexing.schema.json"
        },
        "vendor": {
            "$ref": "vendor.schema.json"
        }
    }
}
