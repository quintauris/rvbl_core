{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "register.schema.json",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": "Register schema for RISC-V",
    "title": "Register",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "$ref": "description.schema.json"
        },
        "class": {
            "enum": [
                "control_status",
                "memory_mapped"
            ]
        },
        "width": {
            "type": "integer"
        },
        "offset": {
            "type": "string"
        },
        "volatile": {
            "type": "boolean"
        },
        "values": {
            "type": "array",
            "items": {
                "$ref": "value.schema.json"
            }
        },
        "fields": {
            "type": "array",
            "items": {
                "$ref": "field.schema.json"
            }
        },
        "indexing": {
            "type": "object",
            "properties": {
                "stride": {
                    "type": "string"
                },
                "lower_bound": {
                    "type": "string"
                },
                "upper_bound": {
                    "type": "string"
                }
            },
            "required": [
                "upper_bound"
            ]
        }
    },
    "required": [
        "name",
        "offset"
    ]
}
